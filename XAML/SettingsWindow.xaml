<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUMig - Einstellungen" Width="880" Height="680" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#FF1E1E2E" Foreground="#FFCDD6F4" FontFamily="Segoe UI" FontSize="12">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#FF181825" Padding="10,6">
            <DockPanel>
                <Image x:Name="imgLogo" DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Einstellungen" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="lblPath" FontSize="10" Foreground="#FF6C7086"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#FF11111B" Padding="10,6">
            <DockPanel>
                <Button x:Name="btnOpenConfig" DockPanel.Dock="Left" Content="Config-Ordner oeffnen" Style="{DynamicResource BtnDefault}" Margin="0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnSave" Content="Speichern" Style="{DynamicResource BtnGreen}" Width="110" Margin="0,0,6,0" FontWeight="Bold"/>
                    <Button x:Name="btnCancel" Content="Abbrechen" Style="{DynamicResource BtnDefault}" Width="100" Margin="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="tabs" Margin="8">

            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Backup-Ordner:" Style="{DynamicResource Lbl}"/>
                        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <Button x:Name="btnRoot" DockPanel.Dock="Right" Content="..." Width="32" Style="{DynamicResource BtnDefault}" Margin="4,0,0,0"/>
                            <TextBox x:Name="txtRoot" Style="{DynamicResource DarkTextBox}" ToolTip="Leer = Unterordner BACKUPS im Tool-Ordner (z.B. am USB-Laufwerk)"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="Robocopy-Threads (Standard):" Style="{DynamicResource Lbl}"/>
                        <ComboBox x:Name="cmbThreads" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Backups aufbewahren (Tage):" Style="{DynamicResource Lbl}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="txtRetention" Style="{DynamicResource DarkTextBox}" Width="60" ToolTip="Aeltere Backups werden erst nach so vielen Tagen zum Loeschen vorgeschlagen. 0 = nur die Anzahl zaehlt"/>
                            <TextBlock Text="neueste" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="14,0,6,0"/>
                            <TextBox x:Name="txtRetentionKeep" Style="{DynamicResource DarkTextBox}" Width="50" ToolTip="Je PC + Benutzer werden die neuesten N Backups nie geloescht (0 = keine Mindestanzahl)"/>
                            <TextBlock Text="je PC + Benutzer immer behalten (Knopf 'Alte Backups ...', vor dem Loeschen wird immer gefragt)" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="6,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="USMT-Ordner (scanstate.exe):" Style="{DynamicResource Lbl}"/>
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,2">
                            <Button x:Name="btnUsmtAdk" DockPanel.Dock="Right" Content="Aus ADK einrichten" Style="{DynamicResource BtnMauve}" Margin="4,0,0,0" ToolTip="USMT aus dem Windows ADK nach BIN\USMT kopieren (ohne ADK: nur USMT still installieren)"/>
                            <Button x:Name="btnUsmt" DockPanel.Dock="Right" Content="..." Width="32" Style="{DynamicResource BtnDefault}" Margin="4,0,0,0"/>
                            <TextBox x:Name="txtUsmt" Style="{DynamicResource DarkTextBox}" ToolTip="Leer = automatisch suchen (BIN\USMT\amd64, Windows ADK)"/>
                        </DockPanel>
                        <TextBlock x:Name="lblUsmt" Grid.Row="4" Grid.Column="1" FontSize="11" Foreground="#FFA6ADC8" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="5" Text="WLAN-Export:" Style="{DynamicResource Lbl}"/>
                        <CheckBox x:Name="chkWlanClear" Grid.Row="5" Grid.Column="1" Content="WLAN-Schluessel im Klartext exportieren (Backup-Laufwerk dann sicher verwahren!)" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="6" Text="Subnetzmaske (Standard):" Style="{DynamicResource Lbl}"/>
                        <TextBox x:Name="txtSubnet" Grid.Row="6" Grid.Column="1" Style="{DynamicResource DarkTextBox}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="7" Text="DNS-Server (je Zeile):" Style="{DynamicResource Lbl}" VerticalAlignment="Top" Margin="0,4,6,0"/>
                        <TextBox x:Name="txtDns" Grid.Row="7" Grid.Column="1" Style="{DynamicResource DarkTextBox}" Width="220" Height="60" HorizontalAlignment="Left" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="9" Text="Softwareverteilung-Ordner:" Style="{DynamicResource Lbl}"/>
                        <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,8,0,0">
                            <Button x:Name="btnSwDir" DockPanel.Dock="Right" Content="..." Width="32" Style="{DynamicResource BtnDefault}" Margin="4,0,0,0"/>
                            <TextBox x:Name="txtSwDir" Style="{DynamicResource DarkTextBox}" ToolTip="Leer = Unterordner Softwareverteilung im Tool-Ordner. Auch Netzwerkfreigabe moeglich."/>
                        </DockPanel>
                        <TextBlock Grid.Row="10" Text="Treiberverteilung-Ordner:" Style="{DynamicResource Lbl}"/>
                        <DockPanel Grid.Row="10" Grid.Column="1" Margin="0,8,0,0">
                            <Button x:Name="btnDrvDir" DockPanel.Dock="Right" Content="..." Width="32" Style="{DynamicResource BtnDefault}" Margin="4,0,0,0"/>
                            <TextBox x:Name="txtDrvDir" Style="{DynamicResource DarkTextBox}" ToolTip="Leer = Unterordner Treiberverteilung im Tool-Ordner. Auch Netzwerkfreigabe moeglich."/>
                        </DockPanel>
                        <TextBlock Grid.Row="12" Text="Anzeige-Groesse:" Style="{DynamicResource Lbl}"/>
                        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <ComboBox x:Name="cmbUiScale" Width="140"/>
                            <TextBlock Text="Text + Oberflaeche skalieren. Automatisch = verkleinert auf kleinen Bildschirmen. Im Hauptfenster: Strg + Mausrad, Strg + 0 = automatisch" Foreground="#FFA6ADC8" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="440"/>
                        </StackPanel>
                        <TextBlock Grid.Row="11" Text="Backup-Uebersicht:" Style="{DynamicResource Lbl}"/>
                        <CheckBox x:Name="chkOverviewAuto" Grid.Row="11" Grid.Column="1" Content="Backups.html im Backup-Ordner nach jedem Backup/Restore aktualisieren" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="8" Text="Starter:" Style="{DynamicResource Lbl}"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnLauncher" Content="HUMig.exe neu erstellen" Style="{DynamicResource BtnMauve}" ToolTip="Starter mit Logo (startet HUMig ohne Konsolenfenster, kann an die Taskleiste angeheftet werden)"/>
                            <Button x:Name="btnShortcut" Content="Desktop-Verknuepfung" Style="{DynamicResource BtnDefault}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Restore">
                <StackPanel Margin="4">
                    <TextBlock Text="Vorauswahl der Nacharbeiten im Reiter Restore:" Style="{DynamicResource Lbl}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="chkRGp" Content="gpupdate /force"/>
                    <CheckBox x:Name="chkRWu" Content="Treiber ueber Windows Update deaktivieren"/>
                    <CheckBox x:Name="chkRNum" Content="NumLock beim Start an"/>
                    <CheckBox x:Name="chkRFav" Content="Explorer: alte 'Favoriten' einblenden"/>
                    <CheckBox x:Name="chkRFast" Content="Schnellstart (Fast Boot) aus"/>
                    <TextBlock Text="Nach-Skript (.ps1, wird am Ziel-PC als Administrator ausgefuehrt):" Style="{DynamicResource Lbl}" Margin="0,10,0,4"/>
                    <DockPanel>
                        <Button x:Name="btnRScript" DockPanel.Dock="Right" Content="..." Width="32" Style="{DynamicResource BtnDefault}" Margin="4,0,0,0"/>
                        <TextBox x:Name="txtRScript" Style="{DynamicResource DarkTextBox}"/>
                    </DockPanel>
                    <TextBlock Text="Checkliste nach dem Restore (ein Punkt je Zeile, wird im Restore-Protokoll abgehakt):" Style="{DynamicResource Lbl}" Margin="0,14,0,4"/>
                    <TextBox x:Name="txtChecklist" Style="{DynamicResource DarkTextBox}" Height="170" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <CheckBox x:Name="chkChecklistAuto" Content="Checkliste nach jedem Restore automatisch anzeigen (Programm-Nacharbeiten aus dem Programm-Katalog kommen dazu)" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Standorte" x:Name="tabSchools">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="btnSchoolAdd" Content="+ Standort" Style="{DynamicResource BtnGreen}"/>
                            <Button x:Name="btnSchoolDel" Content="- Entfernen" Style="{DynamicResource BtnRed}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Profile fuer mehrere Standorte (Schulen, Filialen, Abteilungen ...) - Namen frei waehlbar. Umschalten oben im Hauptfenster (Standort). Leere Felder = Wert aus 'Allgemein'. DNS: mehrere mit Komma trennen." Foreground="#FFA6ADC8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="dgSchools" Style="{DynamicResource DarkGrid}" IsReadOnly="False" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Backup-Ordner" Binding="{Binding BackupRoot, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Softwareverteilung" Binding="{Binding SoftwareFolder, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Treiberverteilung" Binding="{Binding DriverFolder, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="USMT-Ordner" Binding="{Binding UsmtPath, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Domaene/DC" Binding="{Binding ADServer, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Subnetz" Binding="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="DNS-Server" Binding="{Binding DnsServers, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Notiz" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Ausnahmen" x:Name="tabExceptions">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="btnExcDefault" DockPanel.Dock="Right" Content="Standard wiederherstellen" Style="{DynamicResource BtnPeach}" Margin="0"/>
                        <TextBlock Text="Ein Eintrag pro Zeile, * und ? erlaubt. Ordner ohne * gelten nur direkt im Quellordner, mit * in jeder Ebene." Foreground="#FFA6ADC8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <UniformGrid Columns="3" Rows="2">
                        <DockPanel Margin="0,0,6,6"><TextBlock DockPanel.Dock="Top" Text="PROFIL - ORDNER" Style="{DynamicResource SectionLabel}"/><TextBox x:Name="txtExPF" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
                        <DockPanel Margin="0,0,6,6"><TextBlock DockPanel.Dock="Top" Text="PROFIL - DATEITYPEN" Style="{DynamicResource SectionLabel}"/><TextBox x:Name="txtExPFi" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
                        <DockPanel Margin="0,0,0,6"><TextBlock DockPanel.Dock="Top" Text="PROFIL - MINIMAL (Ordner)" Style="{DynamicResource SectionLabel}"/><TextBox x:Name="txtExPMin" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
                        <DockPanel Margin="0,0,6,0"><TextBlock DockPanel.Dock="Top" Text="C:\ - ORDNER" Style="{DynamicResource SectionLabel}"/><TextBox x:Name="txtExSF" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
                        <DockPanel Margin="0,0,6,0"><TextBlock DockPanel.Dock="Top" Text="C:\ - DATEITYPEN" Style="{DynamicResource SectionLabel}"/><TextBox x:Name="txtExSFi" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Top" Text="C:\ - MINIMAL (Ordner)" Style="{DynamicResource SectionLabel}"/><TextBox x:Name="txtExSMin" Style="{DynamicResource DarkTextBox}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
                    </UniformGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Module" x:Name="tabModules">
                <DockPanel Margin="4">
                    <Border DockPanel.Dock="Bottom" Background="#FF181825" CornerRadius="6" Padding="8,6" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="EIGENES MODUL HINZUFUEGEN" Style="{DynamicResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="Name:" Style="{DynamicResource Lbl}"/>
                                <TextBox x:Name="txtNmName" Grid.Column="1" Style="{DynamicResource DarkTextBox}" Margin="0,0,8,4"/>
                                <TextBlock Grid.Column="2" Text="Gruppe:" Style="{DynamicResource Lbl}"/>
                                <ComboBox x:Name="cmbNmGroup" Grid.Column="3" IsEditable="True" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Text="Art:" Style="{DynamicResource Lbl}"/>
                                <ComboBox x:Name="cmbNmType" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Dateifilter:" Style="{DynamicResource Lbl}"/>
                                <TextBox x:Name="txtNmFilter" Grid.Row="1" Grid.Column="3" Style="{DynamicResource DarkTextBox}" Margin="0,0,0,4" ToolTip="Nur bei 'Dateien': z.B. *.xml;*.ini"/>
                                <TextBlock Grid.Row="2" Text="Pfad / Schluessel:" Style="{DynamicResource Lbl}"/>
                                <TextBox x:Name="txtNmPath" Grid.Row="2" Grid.Column="1" Style="{DynamicResource DarkTextBox}" Margin="0,0,8,0" ToolTip="Ordner mit Platzhaltern {APPDATA}, {LOCALAPPDATA}, {PROFILE}, {PROGRAMFILES}, {PROGRAMFILESX86}, {PROGRAMDATA}, {SYSTEMDRIVE} - oder Registry: HKCU\Software\... / HKLM\Software\..."/>
                                <Button x:Name="btnNmAdd" Grid.Row="2" Grid.Column="3" Content="Hinzufuegen" Style="{DynamicResource BtnGreen}" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="btnAppEditor" Content="Programm-Katalog bearbeiten ..." Style="{DynamicResource BtnMauve}" ToolTip="Programme, deren Einstellungen, Plug-ins, Lizenzdateien und Datenbanken mitgesichert werden (Config\apps.json)"/>
                            <Button x:Name="btnModDel" Content="Eigenes Modul loeschen" Style="{DynamicResource BtnRed}"/>
                            <Button x:Name="btnModJson" Content="modules.json (Experten)" Style="{DynamicResource BtnDefault}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Anzeigen = Checkbox im Tool sichtbar, Standard = beim Start angehakt." Foreground="#FFA6ADC8" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="dgModules" Style="{DynamicResource DarkGrid}" IsReadOnly="False" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Anzeigen" Binding="{Binding Anzeigen, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Standard" Binding="{Binding Standard, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Gruppe" Binding="{Binding Gruppe}" IsReadOnly="True" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="Herkunft" Binding="{Binding Herkunft}" IsReadOnly="True" Width="Auto" MinWidth="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Links">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="btnLinkAdd" Content="+ Link" Style="{DynamicResource BtnGreen}"/>
                            <Button x:Name="btnLinkDel" Content="- Entfernen" Style="{DynamicResource BtnRed}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Platzhalter in der URL: {SERIAL} = Seriennummer, {COMPUTER} = PC-Name" Foreground="#FFA6ADC8" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="dgLinks" Style="{DynamicResource DarkGrid}" IsReadOnly="False" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="250"/>
                            <DataGridCheckBoxColumn Header="SN kopieren" Binding="{Binding CopySerial, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Update">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="GitHub-Besitzer:" Style="{DynamicResource Lbl}"/>
                    <TextBox x:Name="txtOwner" Grid.Column="1" Style="{DynamicResource DarkTextBox}" Width="260" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Repository:" Style="{DynamicResource Lbl}"/>
                    <TextBox x:Name="txtRepo" Grid.Row="1" Grid.Column="1" Style="{DynamicResource DarkTextBox}" Width="260" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Text="Branch:" Style="{DynamicResource Lbl}"/>
                    <TextBox x:Name="txtBranch" Grid.Row="2" Grid.Column="1" Style="{DynamicResource DarkTextBox}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="3" Text="Token (privates Repo):" Style="{DynamicResource Lbl}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="lblToken" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="btnTokenSet" Content="Token eingeben" Style="{DynamicResource BtnBlue}"/>
                        <Button x:Name="btnTokenDel" Content="Token loeschen" Style="{DynamicResource BtnDefault}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Nur-Lese-Token genuegt (Fine-grained PAT, Repository-Zugriff nur auf dieses Repo, 'Contents: Read'). Er wird verschluesselt (DPAPI) nur fuer deinen Windows-Benutzer gespeichert." Foreground="#FFA6ADC8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
